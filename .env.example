# SentinelAI Environment Variables
# Copy this file to .env and replace the values with your secure secrets for production.

# PostgreSQL Database Configuration
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinelpassword
POSTGRES_DB=sentinel_db

# AI Service Configuration
# Uncomment and add your API key if the AI service requires it in the future
# OPENAI_API_KEY=your_openai_api_key_here

# Frontend Configuration (Used during frontend build)
# Set this to the public URL of your backend if deployed remotely
# NEXT_PUBLIC_WS_URL=http://localhost:8080/ws
